{
  "name": "language-hub",
  "version": "2.0.0",
  "private": true,
  "description": "Language Hub — online language school (Chinese, Japanese, Korean, English) taught in Bangla",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:schema": "node --env-file=.env.local scripts/db-schema.mjs",
    "db:import": "node --env-file=.env.local scripts/import-from-mysql.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed-demo.mjs",
    "test:smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.17",
    "next": "^16.4.6",
    "nodemailer": "^10.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "mysql2": "^3.24.6",
    "typescript": "^5.9.3"
  }
}
