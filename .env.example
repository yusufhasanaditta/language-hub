# Copy to .env.local (or run `vercel env pull .env.local`).

# Postgres (Neon) — added automatically by the Vercel Neon integration
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Random 32+ character string used to sign login cookies
SESSION_SECRET=change-me

# Optional: email login codes (Gmail: smtp.gmail.com / 465 / App Password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Language Hub

# Optional: SSLCommerz online payments (sandbox unless SSLCZ_LIVE=1)
SSLCZ_STORE_ID=
SSLCZ_STORE_PASS=
SSLCZ_LIVE=0
