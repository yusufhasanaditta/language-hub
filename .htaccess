Options -Indexes -MultiViews

# ── Security: block direct access to sensitive files ──────────────────────────
<FilesMatch "^(setup\.php|test\.php|test_db\.php|debug\.php|dump.*|run_cmd\.php|db_update\.php|alter_db\.php|migrate_.*\.php|fix_paths\.php|get_users\.php|\.env|composer\.json|composer\.lock|package\.json|package-lock\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block SQL dumps, archives/backups, logs and data files
<FilesMatch "\.(sql|log|md|zip|rar|7z|tar|gz|bak|old|orig|swp|json|ini|env|cache)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block direct access to config, includes, cache, logs, uploads of non-images
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block config directory
    RewriteRule ^config/ - [F,L]

    # Block includes directory
    RewriteRule ^includes/ - [F,L]

    # Block cache directory
    RewriteRule ^cache/ - [F,L]

    # Block any script inside uploads
    RewriteRule ^uploads/.*\.(php|phtml|phar|php[0-9]|cgi|pl|py|sh)$ - [F,NC,L]

    # Block hidden files/dirs (.git, .vscode, .env ...) but keep .well-known (SSL renewal)
    RewriteCond %{REQUEST_URI} !/\.well-known/
    RewriteRule (^|/)\. - [F,L]

    # Block leftover debug / test scripts if they are ever re-uploaded
    RewriteRule ^(.*/)?(test_[^/]*|diagnos[^/]*|fix_db|get_schema|patch_db|add_col|cpanel_db_sync)\.php$ - [F,NC,L]

    # ── Professional / clean URLs ──────────────────────────────────────────────
    # /course/{slug}           -> course.php?slug={slug}
    RewriteRule ^course/([A-Za-z0-9-]+)/?$ course.php?slug=$1 [L,QSA]

    # /t/{username}            -> teacher-profile.php?slug={username}
    RewriteRule ^t/([A-Za-z0-9._-]+)/?$ teacher-profile.php?slug=$1 [L,QSA]

    # /category/{slug}         -> courses.php?category={slug}
    RewriteRule ^category/([A-Za-z0-9-]+)/?$ courses.php?category=$1 [L,QSA]

    # Drop the .php extension everywhere else (e.g. /dashboard, /my-courses,
    # /teacher/dashboard) without touching a single existing link — old
    # "*.php" URLs keep working exactly as before.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^.]+)$ $1.php [L]
</IfModule>

# ── Security headers ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Remove server signature
    Header unset Server
    Header unset X-Powered-By
</IfModule>

# ── Gzip compression ──────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/x-font-ttf font/opentype image/svg+xml
    # Don't compress already-compressed formats
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|gz|zip|br)$ no-gzip dont-vary
</IfModule>

# ── Browser caching (mod_expires) ─────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 month"

    # HTML — no cache (dynamic)
    ExpiresByType text/html                 "access plus 0 seconds"

    # Data
    ExpiresByType application/json          "access plus 0 seconds"
    ExpiresByType application/xml           "access plus 0 seconds"

    # CSS & JS — 1 week (add ?v= param to bust)
    ExpiresByType text/css                  "access plus 1 week"
    ExpiresByType application/javascript    "access plus 1 week"
    ExpiresByType text/javascript           "access plus 1 week"

    # Images — 1 month
    ExpiresByType image/jpeg                "access plus 1 month"
    ExpiresByType image/png                 "access plus 1 month"
    ExpiresByType image/webp                "access plus 1 month"
    ExpiresByType image/gif                 "access plus 1 month"
    ExpiresByType image/svg+xml             "access plus 1 month"
    ExpiresByType image/x-icon              "access plus 1 year"

    # Fonts
    ExpiresByType font/ttf                  "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType application/font-woff     "access plus 1 year"
    ExpiresByType application/font-woff2    "access plus 1 year"
</IfModule>

# ── Cache-Control headers ─────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # CSS/JS: stale-while-revalidate for CDN-friendly caching
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    </FilesMatch>
    # Images
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
    # Fonts
    <FilesMatch "\.(ttf|woff|woff2|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # PHP pages — no store
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# ── Keep-Alive ────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>
